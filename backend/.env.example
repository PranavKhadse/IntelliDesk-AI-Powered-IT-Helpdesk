# IntelliDesk Backend Environment Variables (Development Template)

# Application Settings
ENVIRONMENT=development
APP_NAME=IntelliDesk
DEBUG=True

# Security (Generate a secure 32+ character random string in production)
SECRET_KEY=your-secure-secret-key-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Primary Database (PostgreSQL required for application runtime)
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/intellidesk_db

# CORS Configuration (Allowed origins separated by comma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Standalone ML / FAISS Artifact Paths
ML_MODEL_PATH=app/ml/artifacts/triage_classifier.joblib
FAISS_INDEX_PATH=app/rag/artifacts/faiss_index.bin
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# AI Provider Configuration (backend only; do not expose these values to the frontend)
AI_PROVIDER=openai_compatible
AI_API_KEY=your_ai_provider_api_key_here
AI_MODEL=your_model_name_here
AI_API_BASE_URL=https://your-provider.example/v1
AI_TIMEOUT_SECONDS=10
